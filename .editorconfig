# Lint baseline. shfmt reads its options from here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.py]
indent_size = 4

[*.{md,qmd,Rmd}]
trim_trailing_whitespace = false

[{Makefile,*.mk,go.mod,*.go}]
indent_style = tab

[*.{sh,bash}]
binary_next_line = true
switch_case_indent = true
